From 5fa0aa31593282d505b68db89026bdedd0bb16ef Mon Sep 17 00:00:00 2001
From: VinhNgT <victorpublic0000@gmail.com>
Date: Mon, 31 Aug 2026 11:57:41 +0700
Subject: [PATCH] imagebuilder: list remote userland feeds in standalone apk
 builds

A standalone ImageBuilder (CONFIG_IB_STANDALONE=y) bundles every package
that was built with the firmware, but writes no repositories file at
all, so any plain userland package that was not part of the build fails
with "no such package" - even though it is kernel-independent and
published in the official per-arch feeds.

Disabling IB_STANDALONE is not an answer for a tree with an out-of-tree
kernel driver: that variant bundles only base-files/libc/kernel and
lists the per-target feed, whose kmods were built against the official
kernel and can never install on a self-built one (vermagic).

Emit a repositories file for the standalone apk ImageBuilder listing
only the per-arch userland feeds (base plus the enabled feeds, mirroring
FeedSourcesAppendAPK). The per-target and kmods feeds are deliberately
omitted, so kernel-dependent packages keep resolving exclusively from
the bundled packages/ directory that matches the shipped kernel.
Signature checking works as-is: keys/ already ships the distro public
keys, and apk pulls the local bundle via a separate --repository flag.

Feeds enabled =m are emitted commented out, as in FeedSourcesAppendAPK;
apk treats '#' lines as comments.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 target/imagebuilder/Makefile | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/target/imagebuilder/Makefile b/target/imagebuilder/Makefile
index 03e866e..6eabb18 100644
--- a/target/imagebuilder/Makefile
+++ b/target/imagebuilder/Makefile
@@ -48,6 +48,24 @@ ifneq ($(CONFIG_USE_APK),)
   ifeq ($(CONFIG_IB_STANDALONE),)
 	$(call FeedSourcesAppendAPK,$(PKG_BUILD_DIR)/repositories)
 	$(VERSION_SED_SCRIPT) $(PKG_BUILD_DIR)/repositories
+  else
+	# A standalone ImageBuilder bundles every package built with the
+	# firmware, but plain userland packages that were not built are
+	# otherwise uninstallable. List the remote userland feeds so apk can
+	# still fetch those; deliberately omit the per-target feed and the
+	# kmods feed - their kernel-dependent packages come from a foreign
+	# kernel build and must only ever resolve from the local packages/.
+	( \
+		echo '## Remote userland feeds. Kernel packages (kmod-*) are'; \
+		echo '## deliberately not listed: they resolve from the bundled'; \
+		echo '## packages/ directory, which matches this exact kernel.'; \
+		$(strip $(if $(CONFIG_PER_FEED_REPO), \
+			echo '%U/packages/%A/base/packages.adb'; \
+			$(foreach feed,$(FEEDS_AVAILABLE), \
+				$(if $(CONFIG_FEED_$(feed)), \
+					echo '$(if $(filter m,$(CONFIG_FEED_$(feed))),# )%U/packages/%A/$(feed)/packages.adb';)))) \
+	) >> $(PKG_BUILD_DIR)/repositories
+	$(VERSION_SED_SCRIPT) $(PKG_BUILD_DIR)/repositories
   endif
 
 	$(INSTALL_DATA) ./files/README.apk.md $(PKG_BUILD_DIR)/packages/README.md
-- 
